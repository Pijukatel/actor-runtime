{
	"name": "moebelix-category-scraper",
	"version": "0.0.1",
	"type": "module",
	"description": "Scrapes products from a chosen furniture category on moebelix.cz through Apify Proxy.",
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@crawlee/cheerio": "^3.15.3",
		"@crawlee/impit-client": "^3.18.1",
		"apify": "^3.7.0"
	},
	"devDependencies": {
		"@apify/tsconfig": "^0.2.0",
		"@types/node": "^24.0.0",
		"tsx": "^4.20.3",
		"typescript": "^6.0.0"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
